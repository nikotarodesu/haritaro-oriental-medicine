# ==============================================================================
# haritaro.jp 環境変数設定テンプレート
# 本番環境（Vercel）またはローカル環境（.env.local）に設定して利用します。
# ==============================================================================

# サイトの基本URL（リダイレクトやWebhookの検証で使用）
NEXT_PUBLIC_APP_URL=https://www.haritaro.jp

# サブスクリプション販売の有効化フラグ
# true にするとStripe決済の本番/テスト実課金フローが有効になります。
# false または未設定の場合は安全なプレビュー・デモ体験モードとして動作します。
NEXT_PUBLIC_ENABLE_SUBSCRIPTION_SALES=false

# Stripe 公開可能キー（クライアント側用）
# 例: pk_live_... または pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe シークレットキー（サーバー側用）
# 例: sk_live_... または sk_test_...
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Webhook 署名シークレット
# 例: whsec_...
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Stripe 商品価格ID（Stripeダッシュボードで作成した価格ID）
# 月額980円（税込）
STRIPE_PRICE_ID_MONTHLY=price_haritaro_monthly_980
# 年額9,800円（税込）
STRIPE_PRICE_ID_YEARLY=price_haritaro_yearly_9800
