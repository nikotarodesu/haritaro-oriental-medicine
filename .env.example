# ==============================================================================
# haritaro.jp 環境変数設定テンプレート
# 本番環境（Vercel）またはローカル環境（.env.local）に設定して利用します。
# ==============================================================================

# サイトの基本URL（リダイレクトやWebhookの検証で使用）
NEXT_PUBLIC_APP_URL=https://www.haritaro.jp

# Google Analytics 4 (GA4) 測定ID（G-XXXXXXXXXX）
# 未設定・仮IDの場合は計測しません。はり太郎専用IDを指定してください。
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Microsoft Clarity: public landing pages only; blank disables replay.
NEXT_PUBLIC_CLARITY_ID=

# AdSense（Vercel Production に設定し、変更後に再デプロイ）
# ca-pub- から始まる実際のサイト運営者の ID を設定すると /ads.txt に掲載されます。
ADSENSE_PUBLISHER_ID=
# レスポンシブ ディスプレイ広告ユニットの ID（東洋医学の記事末尾）
ADSENSE_ARTICLE_SLOT_ID=
# サイト審査の「準備完了」と Privacy & messaging の同意設定を確認してから配信を有効にします。
# AdSense の自動広告は無効にし、この広告ユニットだけを使用します。
ADSENSE_ENABLED=false

# 改善比較レポート（ローカル/サーバー専用。公開変数にしない）
GA4_PROPERTY_ID=
GSC_SITE_URL=sc-domain:haritaro.jp
# 読み取り権限を付与したサービスアカウントのJSONファイルへの絶対パス
GOOGLE_APPLICATION_CREDENTIALS=

# 旧サブスクリプション連携。本番 Webhook の停止を確認するまで運用中の値を保持します。
# 新規申し込みは終了しています。新しい環境で販売を有効にする必要はありません。
NEXT_PUBLIC_ENABLE_SUBSCRIPTION_SALES=false

# Stripe 公開可能キー（クライアント側用）
# 例: pk_live_... または pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe シークレットキー（サーバー側用）
# 例: sk_live_... または sk_test_...
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Webhook 署名シークレット
# 例: whsec_...
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Stripe 商品価格ID（Stripeダッシュボードで作成した価格ID）
# 月額980円（税込）
STRIPE_PRICE_ID_MONTHLY=price_REPLACE_WITH_MONTHLY_ID
# 年額9,800円（税込）
STRIPE_PRICE_ID_YEARLY=price_REPLACE_WITH_YEARLY_ID

# Supabase 設定
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Identity Services (IDトークン連携) Web クライアントID
# Google Cloud Console の「APIとサービス」>「認証情報」で作成したOAuth 2.0 WebクライアントIDを設定します。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# サーバーだけで使用するSupabase管理キー。NEXT_PUBLIC_を付けないでください。
# 旧 Stripe Webhook で既存取引の通知を処理する間だけ使用します。
SUPABASE_SERVICE_ROLE_KEY=
