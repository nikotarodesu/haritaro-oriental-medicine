# ==========================================
# はり太郎の東洋医学 (haritaro.jp) 環境変数一覧
# ==========================================

# 1. Google Analytics 4 (GA4)
# Google Analytics 管理画面（データストリーム）で取得した測定ID（例: G-XXXXXXXXXX）を設定します。
# 設定すると、自動的にアクセス解析タグ（gtag.js）が配信されます。
NEXT_PUBLIC_GA_ID=

# 2. Google Search Console (GSC)
# Google Search Consoleの所有権確認で「HTML タグ」を選択した際に表示される
# content="..." の英数字文字列を設定します。
# （例: content="abc123xyz_verification_code" の場合、その値を入力）
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
